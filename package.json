{
  "name": "@skvostik/skva",
  "version": "1.0.0",
  "description": "TypeScript library for the SKVA encrypted backup archive format",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skvostik/skva-ts.git"
  },
  "bugs": {
    "url": "https://github.com/skvostik/skva-ts/issues"
  },
  "homepage": "https://github.com/skvostik/skva-ts#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SKVA_FORMAT.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "skva",
    "encryption",
    "backup",
    "stream",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm test && npm run clean && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.1",
    "@noble/hashes": "^2.2.0",
    "@noble/post-quantum": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
